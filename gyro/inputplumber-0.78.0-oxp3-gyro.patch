+/// Runtime state of the gyro bias compensation
+struct GyroCalibState {
+    /// Current bias estimate in rad/s (sensor frame)
+    bias: [f64; 3],
+    auto: bool,
+    window: VecDeque<[f64; 3]>,
+    accel_window: VecDeque<[f64; 3]>,
+}
+
+impl GyroCalibState {
+    fn new(config: GyroCalibration) -> Self {
+        let mut bias = [0.0; 3];
+        for k in 0..3 {
+            bias[k] = config.bias_deg[k] * PI / 180.0;
+        }
+        log::info!(
+            "Gyro bias compensation: static {:?} deg/s, auto calibrate: {}",
+            config.bias_deg,
+            config.auto_calibrate
+        );
+        Self {
+            bias,
+            auto: config.auto_calibrate,
+            window: VecDeque::with_capacity(CALIB_WINDOW),
+            accel_window: VecDeque::with_capacity(CALIB_WINDOW),
+        }
+    }
+
+    /// Update the at-rest estimate with the given raw sample and subtract the bias
+    fn apply(&mut self, value: &mut [f64; 3], accel: [f64; 3]) {
+        if self.auto {
+            self.window.push_back(*value);
+            self.accel_window.push_back(accel);
+            if self.window.len() >= CALIB_WINDOW {
+                let mut gyro_ptp: f64 = 0.0;
+                let mut accel_ptp: f64 = 0.0;
+                let mut mean = [0.0; 3];
+                for k in 0..3 {
