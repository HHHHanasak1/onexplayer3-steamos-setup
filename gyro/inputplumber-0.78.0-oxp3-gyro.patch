+                    (CALIB_BLEND, f64::MAX)
+                } else if gyro_ptp < CALIB_LOOSE_PTP && accel_ptp < CALIB_LOOSE_ACCEL_PTP {
+                    (CALIB_LOOSE_BLEND, CALIB_LOOSE_MAX_STEP)
+                } else {
+                    (0.0, 0.0)
+                };
+                if blend > 0.0 {
