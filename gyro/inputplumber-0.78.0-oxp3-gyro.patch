diff --git a/src/input/target/gyro_steer.rs b/src/input/target/gyro_steer.rs
new file mode 100644
index 0000000..d5d9143
--- /dev/null
+++ b/src/input/target/gyro_steer.rs
@@ -0,0 +1,268 @@
+//! OXP3 gyro drift handling for the virtual Steam Deck (deck-uhid target).
+//!
+//! Steam's "gyro to joystick (deflection)" integrates the yaw rate we send into an angle. About the screen
+//! normal gravity cannot observe the angle, so any gyro bias becomes a runaway centre drift. This module shapes
+//! the rate stream before it reaches Steam:
+//!   * `gyro` mode (default): the yaw rate is passed through a slow high-pass - a mirror of Steam's integral is
+//!     kept and a small return rate (-angle / tau) is folded into the output, so Steam's own integrated angle
+//!     relaxes toward centre with time constant `tau`. A constant bias then ends up as a bounded offset
+//!     (bias * tau) instead of a drift, and the stream has ~zero mean so Steam's bias estimator has nothing to
+//!     fight. Optional at-rest bias learning on top.
+//!   * `stick` mode: the same angle is mapped to a left-stick X deflection instead (no gyro in Steam needed).
+//! Parameters: `/etc/inputplumber/oxp3-gyro-steer.conf` (key=value, re-read every 2 s).
+use std::{fs, time::{Duration, Instant, SystemTime}};
+
+const CONF_PATH: &str = "/etc/inputplumber/oxp3-gyro-steer.conf";
+const GYRO_LSB_PER_DPS: f64 = 16.0;
+const ACCEL_LSB_PER_G: f64 = 16384.0;
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum Mode {
+    Gyro,
+    Stick,
+}
+
+#[derive(Clone, Copy, Debug)]
+struct Params {
+    enabled: bool,
+    mode: Mode,
+    tau: f64,         // seconds: the integrated angle relaxes toward centre with this time constant
+    bias_auto: bool,  // learn the gyro bias while the device rests
+    bias_gyro_ptp: f64,  // deg/s: max gyro span inside a still window
+    bias_accel_ptp: f64, // g: max accelerometer span inside a still window
+    // gyro mode response shaping: Steam's integrated angle becomes gain * curve(theta)
+    range: f64, // degrees: knee of the curve (curve(range) == range)
+    curve: f64, // 0 = linear; k gives slope 1+k near centre tapering to 1-k at `range`
+    gain: f64,  // overall multiplier
+    // stick mode only
+    max_angle: f64,
+    deadzone: f64,
+    accel_gain: f64,
+    smooth_hz: f64,
+    invert: bool,
+    upright_min: f64,
+}
+
+impl Default for Params {
+    fn default() -> Self {
+        Self {
+            enabled: false,
+            mode: Mode::Gyro,
+            tau: 20.0,
+            bias_auto: true,
+            bias_gyro_ptp: 0.6,
+            bias_accel_ptp: 0.02,
+            range: 45.0,
+            curve: 0.0,
+            gain: 1.0,
+            max_angle: 25.0,
+            deadzone: 1.5,
+            accel_gain: 2.0,
+            smooth_hz: 8.0,
+            invert: false,
+            upright_min: 0.6,
+        }
+    }
+}
+
+pub struct GyroSteer {
+    p: Params,
+    conf_checked: Instant,
+    conf_mtime: Option<SystemTime>,
+    angle: f64,      // leaked physical yaw angle, degrees
+    sent_angle: f64, // mirror of Steam's integral of what we sent (== gain * curve(angle) once settled)
+    bias: f64,       // learned bias, deg/s
+    out: f64,   // stick mode: smoothed normalised deflection
+    last_gyro: Option<Instant>,
+    phys_x: i16,
+    accel: [f64; 3],
+    win: Vec<f64>,
+    win_accel: Vec<f64>,
+    win_start: Instant,
+    log_at: Instant,
+}
+
+impl GyroSteer {
+    pub fn new() -> Self {
+        let mut s = Self {
+            p: Params::default(),
+            conf_checked: Instant::now() - Duration::from_secs(10),
+            conf_mtime: None,
+            angle: 0.0,
+            sent_angle: 0.0,
+            bias: 0.0,
+            out: 0.0,
+            last_gyro: None,
+            phys_x: 0,
+            accel: [0.0, 0.0, 1.0],
+            win: Vec::with_capacity(1024),
+            win_accel: Vec::with_capacity(1024),
+            win_start: Instant::now(),
+            log_at: Instant::now(),
+        };
+        s.maybe_reload(Instant::now());
+        s
+    }
+
+    fn maybe_reload(&mut self, now: Instant) {
+        if now.duration_since(self.conf_checked) < Duration::from_secs(2) {
+            return;
+        }
+        self.conf_checked = now;
+        let mtime = fs::metadata(CONF_PATH).and_then(|m| m.modified()).ok();
+        if mtime == self.conf_mtime && mtime.is_some() {
+            return;
+        }
+        self.conf_mtime = mtime;
+        let mut p = Params::default();
+        if let Ok(text) = fs::read_to_string(CONF_PATH) {
+            for line in text.lines() {
+                let line = line.split('#').next().unwrap_or("").trim();
+                let Some((k, v)) = line.split_once('=') else { continue };
+                let (k, v) = (k.trim(), v.trim());
+                let b = |v: &str| matches!(v, "1" | "true" | "yes" | "on");
+                match k {
+                    "enabled" => p.enabled = b(v),
+                    "mode" => p.mode = if v.eq_ignore_ascii_case("stick") { Mode::Stick } else { Mode::Gyro },
+                    "tau" => p.tau = v.parse().unwrap_or(p.tau),
+                    "bias_auto" => p.bias_auto = b(v),
+                    "bias_gyro_ptp" => p.bias_gyro_ptp = v.parse().unwrap_or(p.bias_gyro_ptp),
+                    "bias_accel_ptp" => p.bias_accel_ptp = v.parse().unwrap_or(p.bias_accel_ptp),
+                    "range" => p.range = v.parse().unwrap_or(p.range),
+                    "curve" => p.curve = v.parse().unwrap_or(p.curve),
+                    "gain" => p.gain = v.parse().unwrap_or(p.gain),
+                    "max_angle" => p.max_angle = v.parse().unwrap_or(p.max_angle),
+                    "deadzone" => p.deadzone = v.parse().unwrap_or(p.deadzone),
+                    "accel_gain" => p.accel_gain = v.parse().unwrap_or(p.accel_gain),
+                    "smooth_hz" => p.smooth_hz = v.parse().unwrap_or(p.smooth_hz),
+                    "invert" => p.invert = b(v),
+                    "upright_min" => p.upright_min = v.parse().unwrap_or(p.upright_min),
+                    _ => {}
+                }
+            }
+        }
+        p.tau = p.tau.max(0.5);
+        p.range = p.range.max(5.0);
+        p.curve = p.curve.clamp(0.0, 0.95);
+        p.gain = p.gain.clamp(0.1, 5.0);
+        p.max_angle = p.max_angle.max(1.0);
+        p.deadzone = p.deadzone.clamp(0.0, p.max_angle - 0.5);
+        let changed = self.p.enabled != p.enabled || self.p.mode != p.mode;
+        self.p = p;
+        if !p.enabled || changed {
+            self.angle = 0.0;
+            self.sent_angle = 0.0;
+            self.out = 0.0;
+        }
+        if changed {
+            log::info!("OXP3 gyro drift handling {} ({:?})", if p.enabled { "enabled" } else { "disabled" }, self.p);
+        }
+    }
+
+    /// Accelerometer sample in Steam Deck report units (x right, y top edge, z out of screen)
+    pub fn on_accel(&mut self, x: f64, y: f64, z: f64) {
+        self.accel = [x / ACCEL_LSB_PER_G, y / ACCEL_LSB_PER_G, z / ACCEL_LSB_PER_G];
+    }
+
+    /// Physical left stick X (i16); returns the value to report
+    pub fn set_phys_x(&mut self, v: i16) -> i16 {
+        self.phys_x = v;
+        self.merged()
+    }
+
+    /// Gyro sample about the screen normal in Steam Deck report units (16 LSB per deg/s).
+    /// Returns (rate to report in the same units, Some(left stick X) in stick mode).
+    pub fn on_gyro(&mut self, rate_lsb: f64) -> (f64, Option<i16>) {
+        let now = Instant::now();
+        self.maybe_reload(now);
+        if !self.p.enabled {
+            self.last_gyro = None;
+            return (rate_lsb, None);
+        }
+        let raw = rate_lsb / GYRO_LSB_PER_DPS;
+        let dt = match self.last_gyro {
+            Some(t) => now.duration_since(t).as_secs_f64().min(0.05),
+            None => 0.0,
+        };
+        self.last_gyro = Some(now);
+
+        // at-rest bias learning: 2 s windows with a tiny gyro span and a still accelerometer
+        if self.p.bias_auto {
+            self.win.push(raw);
+            self.win_accel.push(self.accel[0] + self.accel[1] * 3.0 + self.accel[2] * 7.0);
+            if now.duration_since(self.win_start) >= Duration::from_secs(2) {
+                let (mut lo, mut hi, mut sum) = (f64::MAX, f64::MIN, 0.0);
+                for &g in &self.win { lo = lo.min(g); hi = hi.max(g); sum += g; }
+                let (mut alo, mut ahi) = (f64::MAX, f64::MIN);
+                for &a in &self.win_accel { alo = alo.min(a); ahi = ahi.max(a); }
+                if self.win.len() > 100 && hi - lo < self.p.bias_gyro_ptp && ahi - alo < self.p.bias_accel_ptp {
+                    let mean = sum / self.win.len() as f64;
+                    self.bias = 0.8 * self.bias + 0.2 * mean;
+                }
+                self.win.clear();
+                self.win_accel.clear();
+                self.win_start = now;
+            }
+        }
+
+        let rate = raw - self.bias;
+        match self.p.mode {
+            Mode::Gyro => {
+                // slow high-pass on the physical angle: theta' = rate - theta/tau
+                let ret = self.angle / self.p.tau;
+                self.angle += (rate - ret) * dt;
+                self.angle = self.angle.clamp(-720.0, 720.0);
+                // Steam integrates what we send, so send the increment of the shaped angle: Steam's angle then
+                // tracks gain * curve(theta) exactly (any leftover after the rate clamp is sent next sample)
+                let target = self.shaped(self.angle);
+                let sent = if dt > 0.0 { ((target - self.sent_angle) / dt).clamp(-2000.0, 2000.0) } else { 0.0 };
+                self.sent_angle += sent * dt;
+                if now.duration_since(self.log_at) >= Duration::from_secs(10) {
+                    self.log_at = now;
+                    log::debug!("gyro drift: angle {:.2} deg sent {:.2} deg bias {:.3} dps return {:.3} dps", self.angle, self.sent_angle, self.bias, ret);
+                }
+                (sent * GYRO_LSB_PER_DPS, None)
+            }
+            Mode::Stick => {
+                self.angle = (self.angle + rate * dt) * (-dt / self.p.tau).exp();
+                let [ax, ay, az] = self.accel;
+                let total = (ax * ax + ay * ay + az * az).sqrt().max(1e-3);
+                let inplane = (ax * ax + ay * ay).sqrt() / total;
+                if inplane > self.p.upright_min && dt > 0.0 {
+                    let acc_angle = ax.atan2(-ay).to_degrees();
+                    let w = ((inplane - self.p.upright_min) / (1.0 - self.p.upright_min)).clamp(0.0, 1.0);
+                    let k = (self.p.accel_gain * w * dt).min(1.0);
+                    self.angle += k * (acc_angle - self.angle);
+                }
+                self.angle = self.angle.clamp(-90.0, 90.0);
+                let a = if self.p.invert { -self.angle } else { self.angle };
+                let mag = a.abs();
+                let norm = if mag <= self.p.deadzone { 0.0 } else { ((mag - self.p.deadzone) / (self.p.max_angle - self.p.deadzone)).min(1.0) * a.signum() };
+                let alpha = if dt > 0.0 { 1.0 - (-dt * 2.0 * std::f64::consts::PI * self.p.smooth_hz).exp() } else { 1.0 };
+                self.out += alpha * (norm - self.out);
+                if now.duration_since(self.log_at) >= Duration::from_secs(10) {
+                    self.log_at = now;
+                    log::debug!("gyro steer: angle {:.2} deg bias {:.3} dps inplane {:.2} out {:.3}", self.angle, self.bias, inplane, self.out);
+                }
+                (rate_lsb, Some(self.merged()))
+            }
+        }
+    }
+
+    /// Response curve for gyro mode. With x = |theta| / range: (1+k)x - kx^2 up to the knee (slope 1+k at the
+    /// centre, 1-k at the knee), linear with slope 1-k beyond it. Odd-symmetric, scaled by `gain`.
+    fn shaped(&self, theta: f64) -> f64 {
+        let k = self.p.curve;
+        let x = theta.abs() / self.p.range;
+        let g = if x <= 1.0 { (1.0 + k) * x - k * x * x } else { 1.0 + (1.0 - k) * (x - 1.0) };
+        self.p.gain * self.p.range * g * theta.signum()
+    }
+
+    fn merged(&self) -> i16 {
+        if !self.p.enabled || self.p.mode != Mode::Stick {
+            return self.phys_x;
+        }
+        let phys = self.phys_x as f64 / 32767.0;
+        ((phys + self.out).clamp(-1.0, 1.0) * 32767.0).round() as i16
+    }
+}
