+                        let step = (blend * (mean[k] - self.bias[k])).clamp(-max_step, max_step);
+                        self.bias[k] += step;
+                    }
+                    log::debug!(
+                        "Gyro still (ptp {:.2} deg/s, blend {}), bias now [{:.3}, {:.3}, {:.3}] deg/s",
+                        gyro_ptp * 180.0 / PI,
+                        blend,
+                        self.bias[0] * 180.0 / PI,
+                        self.bias[1] * 180.0 / PI,
+                        self.bias[2] * 180.0 / PI
+                    );
+                }
+                self.window.clear();
+                self.accel_window.clear();
+            }
+        }
+        for k in 0..3 {
+            value[k] -= self.bias[k];
+        }
+    }
+}
