+                        lo = lo.min(sample[k]);
+                        hi = hi.max(sample[k]);
+                        sum += sample[k];
+                    }
+                    gyro_ptp = gyro_ptp.max(hi - lo);
+                    mean[k] = sum / self.window.len() as f64;
+                    let mut alo = f64::MAX;
+                    let mut ahi = f64::MIN;
+                    for sample in self.accel_window.iter() {
+                        alo = alo.min(sample[k]);
+                        ahi = ahi.max(sample[k]);
+                    }
+                    accel_ptp = accel_ptp.max(ahi - alo);
+                }
