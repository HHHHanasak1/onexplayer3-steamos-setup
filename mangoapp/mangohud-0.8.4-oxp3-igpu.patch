From 917c6178e89862d8bce5b6448556aac8a8d96a60 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Thu, 5 Nov 2026 14:56:09 +0900
Subject: [PATCH 1/4] gpu_fdinfo: power and temperature for integrated xe GPUs
 without hwmon, SoC (package) power

---
 src/gpu_fdinfo.cpp     | 95 ++++++++++++++++++++++++++++++++++++++++++
 src/gpu_fdinfo.h       | 22 ++++++++++
 src/gpu_metrics_util.h |  1 +
 3 files changed, 118 insertions(+)

diff --git a/src/gpu_fdinfo.cpp b/src/gpu_fdinfo.cpp
index 0a761e4e..b008daae 100644
--- a/src/gpu_fdinfo.cpp
+++ b/src/gpu_fdinfo.cpp
@@ -3,6 +3,8 @@
 #endif
 
 #include "gpu_fdinfo.h"
+#include "file_utils.h"
+#include <unistd.h>
 
 GPU_fdinfo::GPU_fdinfo(
     const std::string driver, const std::string pci_dev, const std::string drm_node,
@@ -14,6 +16,9 @@ GPU_fdinfo::GPU_fdinfo(
 
     gpu.add_pid(pid);
 
+    if (driver == "xe" && !fs::exists("/sys/class/drm/" + drm_node + "/device/hwmon"))
+        find_igpu_sensors();
+
     thread = std::thread(&GPU_fdinfo::main_thread, this);
     // "mangohud-gpufdinfo" wouldn't fit in the 15 byte limit
     pthread_setname_np(thread.native_handle(), "mangohud-gpufd");
@@ -59,6 +64,13 @@ void GPU_fdinfo::main_thread()
         metrics.voltage = gpu.get_voltage();
         metrics.fan_rpm = gpu.get_fan_rpm();
 
+        if (igpu_fallback) {
+            metrics.powerUsage = igpu_energy.read();
+            metrics.temp = read_igpu_temp();
+        }
+        if (soc_available)
+            metrics.soc_power = soc_energy.read();
+
         SPDLOG_DEBUG(
             "pci_dev = {}, pid = {}, driver = {}, "
             "load = {}, temp = {}, junction_temp = {}, memory_temp = {}, sys_vram_used = {}, "
@@ -79,3 +91,86 @@ void GPU_fdinfo::main_thread()
         );
     }
 }
+
+bool GPU_fdinfo::energy_counter::open(const std::string& path)
+{
+    if (access(path.c_str(), R_OK) != 0)
+        return false;
+    stream.open(path);
+    return stream.good();
+}
+
+float GPU_fdinfo::energy_counter::read()
+{
+    // the counter may be refreshed less often than we poll it: use the real time between increases
+    std::string line;
+    stream.clear();
+    stream.seekg(0);
+    if (!std::getline(stream, line) || line.empty())
+        return power;
+    uint64_t e = std::stoull(line);
+    auto t = std::chrono::steady_clock::now();
+    if (last_energy == 0 || e < last_energy) {
+        last_energy = e;
+        last_time = t;
+    } else if (e > last_energy && t > last_time) {
+        power = (e - last_energy) / 1e6f / std::chrono::duration<float>(t - last_time).count();
+        last_energy = e;
+        last_time = t;
+    }
+    return power;
+}
+
+void GPU_fdinfo::find_igpu_sensors()
+{
+    // RAPL PP1 is the graphics power plane on Intel client CPUs; Linux names that zone "uncore".
+    const std::string pp1 = "/sys/class/powercap/intel-rapl:0:1";
+    if (read_line(pp1 + "/name") == "uncore" && igpu_energy.open(pp1 + "/energy_uj"))
+        igpu_fallback = true;
+
+    // the integrated GPU sits on the CPU package: use the coretemp package sensor
+    std::string temp_path;
+    for (const auto& entry : fs::directory_iterator("/sys/class/hwmon")) {
+        std::string dir = entry.path().string();
+        if (read_line(dir + "/name") != "coretemp")
+            continue;
+        for (const auto& f : fs::directory_iterator(dir)) {
+            std::string label = f.path().string();
+            if (label.size() < 6 || label.substr(label.size() - 6) != "_label")
+                continue;
+            if (read_line(label).rfind("Package id", 0) != 0)
+                continue;
+            temp_path = label.substr(0, label.size() - 6) + "_input";
+            igpu_temp.open(temp_path);
+            if (igpu_temp.good())
+                igpu_fallback = true;
+            else
+                temp_path.clear();
+            break;
+        }
+        break;
+    }
+
+    // the package counter covers the whole SoC (CPU cores, GPU and the shared blocks), which the TDP limits
+    const std::string pkg = "/sys/class/powercap/intel-rapl:0";
+    if (igpu_fallback && read_line(pkg + "/name") == "package-0")
+        soc_available = soc_energy.open(pkg + "/energy_uj");
+
+    if (igpu_fallback)
+        SPDLOG_INFO("xe: integrated GPU without hwmon, power from {}, temperature from {}, SoC power {}",
+                    igpu_energy.stream.is_open() ? pp1 + "/energy_uj" : "nowhere",
+                    temp_path.empty() ? "nowhere" : temp_path,
+                    soc_available ? pkg + "/energy_uj" : "not available");
+}
+
+int GPU_fdinfo::read_igpu_temp()
+{
+    if (!igpu_temp.is_open())
+        return 0;
+    std::string line;
+    igpu_temp.clear();
+    igpu_temp.seekg(0);
+    if (!std::getline(igpu_temp, line) || line.empty())
+        return 0;
+    return static_cast<int>(std::lround(std::stoll(line) / 1000.0));
+}
diff --git a/src/gpu_fdinfo.h b/src/gpu_fdinfo.h
index 5dff3af1..96332f73 100644
--- a/src/gpu_fdinfo.h
+++ b/src/gpu_fdinfo.h
@@ -3,6 +3,8 @@
 #include <spdlog/spdlog.h>
 #include "gpu_metrics_util.h"
 #include "../mangohud-next/legacy_gpu_wrapper/wrapper.hpp"
+#include <chrono>
+#include <fstream>
 
 class GPU_fdinfo {
 private:
@@ -25,7 +27,27 @@ private:
 
     void main_thread();
 
+    // Integrated xe GPUs have no hwmon device, so the GPU layer reports no power and no temperature. Then the power
+    // comes from the RAPL graphics plane (PP1, "uncore"), the temperature from the CPU package sensor (same die), and
+    // the whole SoC (RAPL package, what the TDP limits) is shown as its own item.
+    struct energy_counter {
+        std::ifstream stream;
+        uint64_t last_energy = 0;
+        std::chrono::steady_clock::time_point last_time;
+        float power = 0;
+        bool open(const std::string& path);
+        float read();
+    };
+    bool igpu_fallback = false;
+    bool soc_available = false;
+    energy_counter igpu_energy, soc_energy;
+    std::ifstream igpu_temp;
+    void find_igpu_sensors();
+    int read_igpu_temp();
+
 public:
+    bool has_soc_power() const { return soc_available; }
+
     GPU_fdinfo(
         const std::string driver, const std::string pci_dev, const std::string drm_node,
         uint32_t device_id, uint32_t vendor_id
diff --git a/src/gpu_metrics_util.h b/src/gpu_metrics_util.h
index bdc2b266..aa384f38 100644
--- a/src/gpu_metrics_util.h
+++ b/src/gpu_metrics_util.h
@@ -25,6 +25,7 @@ struct gpu_metrics {
     int fan_speed;
     int voltage;
     bool fan_rpm;
+    float soc_power {0.0f};  // whole SoC (RAPL package), integrated xe GPUs only; 0 = not available
 
     gpu_metrics()
         : load(0), temp(0), junction_temp(0), memory_temp(0),
