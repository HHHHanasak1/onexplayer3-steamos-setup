From 4dedd6251010c22ce55575248b6f43e77ed5543f Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Thu, 5 Nov 2026 14:56:09 +0900
Subject: [PATCH 4/4] hud: SoC (package) power element after the CPU and GPU
 for integrated xe GPUs, no empty VRAM item

---
 src/hud_elements.cpp   | 55 ++++++++++++++++++++++++++++++++++++++++++
 src/hud_elements.h     |  2 ++
 src/overlay_params.cpp |  1 +
 3 files changed, 58 insertions(+)

diff --git a/src/hud_elements.cpp b/src/hud_elements.cpp
index e1440fc1..e18ade2f 100644
--- a/src/hud_elements.cpp
+++ b/src/hud_elements.cpp
@@ -418,6 +418,61 @@ void HudElements::gpu_stats(){
     }
 }
 
+// The whole SoC (RAPL package) power of an integrated xe GPU, as its own element after the CPU and GPU ones (see
+// place_soc_element), so the horizontal layout separates it like any other element.
+static std::shared_ptr<GPU> soc_power_gpu()
+{
+    if (!gpus)
+        return nullptr;
+    for (auto& gpu : gpus->selected_gpus())
+        if (gpu->fdinfo && gpu->fdinfo->has_soc_power())
+            return gpu;
+    return nullptr;
+}
+
+void HudElements::soc_stats(){
+    auto gpu = soc_power_gpu();
+    if (!gpu)
+        return;
+    ImguiNextColumnFirstItem();
+    HUDElements.TextColored(HUDElements.colors.engine, "SoC");
+    ImguiNextColumnOrNewRow();
+    auto text_color = HUDElements.colors.text;
+    char str[16];
+    snprintf(str, sizeof(str), "%.1f", gpu->metrics.soc_power);
+    if (strlen(str) > 4)
+        right_aligned_text(text_color, HUDElements.ralign_width, "%.0f", gpu->metrics.soc_power);
+    else
+        right_aligned_text(text_color, HUDElements.ralign_width, "%.1f", gpu->metrics.soc_power);
+    ImGui::SameLine(0, 1.0f);
+    ImGui::PushFont(HUDElements.sw_stats->font_small);
+    HUDElements.TextColored(HUDElements.colors.text, "W");
+    ImGui::PopFont();
+}
+
+// Put the SoC element right after the last of gpu_stats, cpu_stats and core_load (the presets order them differently;
+// level 4 lists every core after the CPU), only where GPU power is shown (Steam overlay levels 2-4) and only when the
+// GPU has a package counter. Such a GPU is integrated and has no VRAM of its own, so the empty VRAM item goes away.
+void HudElements::place_soc_element(const overlay_params* p){
+    ordered_functions.erase(std::remove_if(ordered_functions.begin(), ordered_functions.end(),
+                                           [](const Function& f) { return f.name == "soc_stats"; }),
+                            ordered_functions.end());
+    if (!soc_power_gpu())
+        return;
+    ordered_functions.erase(std::remove_if(ordered_functions.begin(), ordered_functions.end(),
+                                           [](const Function& f) { return f.name == "vram"; }),
+                            ordered_functions.end());
+    if (!p->enabled[OVERLAY_PARAM_ENABLED_gpu_stats] || !p->enabled[OVERLAY_PARAM_ENABLED_gpu_power])
+        return;
+    int last = -1;
+    for (size_t i = 0; i < ordered_functions.size(); i++)
+        if (ordered_functions[i].name == "gpu_stats" || ordered_functions[i].name == "cpu_stats" ||
+            ordered_functions[i].name == "core_load")
+            last = int(i);
+    if (last >= 0)
+        ordered_functions.insert(ordered_functions.begin() + last + 1, {soc_stats, "soc_stats", "NULL"});
+}
+
 void HudElements::cpu_stats(){
     if(HUDElements.params->enabled[OVERLAY_PARAM_ENABLED_cpu_stats]){
         ImguiNextColumnFirstItem();
