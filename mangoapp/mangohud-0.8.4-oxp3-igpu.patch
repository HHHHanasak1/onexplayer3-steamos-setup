From 8447ccd6bdd621e9381f9021406543c7ca91f74f Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Thu, 5 Nov 2026 14:56:09 +0900
Subject: [PATCH 2/4] mangoapp: exit at once after an X error instead of
 hanging in the normal exit path

---
 src/app/main.cpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/app/main.cpp b/src/app/main.cpp
index 2371feac..83f48892 100644
--- a/src/app/main.cpp
+++ b/src/app/main.cpp
@@ -669,6 +669,15 @@ int main(int, char**)
         }
     }
 
+    // After an X error the normal exit path can hang (exit() waits in static destructors for the worker threads),
+    // leaving a mangoapp that runs but never draws (seen when it starts before gamescope is ready at boot). Exit
+    // immediately instead, so systemd restarts it.
+    if (g_x_dead.load()) {
+        fprintf(stderr, "mangoapp: X connection lost, exiting so the overlay gets restarted\n");
+        fflush(stderr);
+        _exit(1);
+    }
+
     shutdown(window);
 
     glfwTerminate();
-- 
2.52.0.windows.1


