#!/bin/bash
appid=${SteamAppId:-${STEAM_COMPAT_APP_ID:-0}}
conf=${XDG_CONFIG_HOME:-$HOME/.config}/oxp3-game-pack/$appid.conf
log=${XDG_CACHE_HOME:-$HOME/.cache}/oxp3-game-pack/launch.log
state=off
if [ "${OXP3_PACK:-1}" != 0 ] && [ -f "$conf" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case $line in
      ''|'#'*) ;;
      *=*) export "${line?}" ;;
    esac
  done < "$conf"
  state=on
  if [ -n "${OXP3_DRIVER:-}" ] && ! python3 -I -c 'import ctypes, sys; ctypes.CDLL(sys.argv[1])' "$OXP3_DRIVER" 2>/dev/null; then
    unset VK_DRIVER_FILES DRIRC_CONFIGDIR
    state=on-stock-driver
  fi
fi
mkdir -p "${log%/*}" 2>/dev/null && printf '%s appid=%s pack=%s\n' "$(date -Is)" "$appid" "$state" >> "$log" 2>/dev/null
exec "$@"
