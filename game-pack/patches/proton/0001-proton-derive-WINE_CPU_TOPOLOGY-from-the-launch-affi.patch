From d3cb9bceffa7309981ba7fee8b6900056134ead0 Mon Sep 17 00:00:00 2001
From: perf <perf@localhost>
Date: Sun, 18 Oct 2026 12:44:45 -0500
Subject: [PATCH] proton: derive WINE_CPU_TOPOLOGY from the launch affinity on
 every architecture

---
 proton | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/proton b/proton
index 066701c..a6ef1ee 100755
--- a/proton
+++ b/proton
@@ -1572,7 +1572,7 @@ class Session:
             self.env["WINE_CPU_TOPOLOGY"] = self.env["PROTON_CPU_TOPOLOGY"]
         elif appid in default_cpu_limit:
             self.env["WINE_CPU_TOPOLOGY"] = default_cpu_limit[appid]
-        elif "WINE_CPU_TOPOLOGY" not in self.env and platform.machine() == 'aarch64':
+        elif "WINE_CPU_TOPOLOGY" not in self.env:
             topo_str = get_current_cpu_affinity()
             if topo_str != "":
                 self.env["WINE_CPU_TOPOLOGY"] = topo_str
